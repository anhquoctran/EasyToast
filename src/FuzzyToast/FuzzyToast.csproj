<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net461 is the first Framework TFM that can consume netstandard2.0 (4.6.1+). -->
    <TargetFrameworks>net461;net8.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>FuzzyToast</RootNamespace>
    <AssemblyName>FuzzyToast</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>FuzzyToast</PackageId>
    <Title>FuzzyToast</Title>
    <Authors>anhquoctran</Authors>
    <Company>anhquoctran</Company>
    <Copyright>Copyright © 2018–2026 anhquoctran</Copyright>
    <Description>Toast notifications for Windows Forms on .NET Framework 4.6.1+ and .NET 8+ (Windows 10/11). Android-style API, inputable toasts with submit, DPI-aware layout, four-corner stacking.</Description>
    <PackageProjectUrl>https://github.com/anhquoctran/FuzzyToast</PackageProjectUrl>
    <RepositoryUrl>https://github.com/anhquoctran/FuzzyToast</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugType>portable</DebugType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageTags>winforms;toast;notification;ui;windows10;windows11;net8;net461;net48;input</PackageTags>
    <PackageReleaseNotes>See https://github.com/anhquoctran/FuzzyToast/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <Version>3.0.3</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net461'">
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.ValueTuple" Version="4.5.0" />
    <PackageReference Include="System.Resources.Extensions" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\CHANGELOG.md" Pack="true" PackagePath="\" />
    <None Include="icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
