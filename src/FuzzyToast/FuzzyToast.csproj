<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- .NET 8+ Windows Forms. Package is consumable by net8.0-windows and later (net9, …). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <RootNamespace>FuzzyToast</RootNamespace>
    <AssemblyName>FuzzyToast</AssemblyName>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Analyzer platform: Windows desktop (runtime target: Windows 10/11). -->
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>

    <PackageId>FuzzyToast</PackageId>
    <Title>FuzzyToast</Title>
    <Authors>anhquoctran</Authors>
    <Description>Toast notifications for Windows Forms on Windows 10/11 (.NET 8+). Android-style Toast.Build API, DPI-aware layout, four-corner stacking.</Description>
    <PackageProjectUrl>https://github.com/anhquoctran/EasyToast</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>winforms;toast;notification;ui;windows10;windows11;net8</PackageTags>
    <Version>2.0.0</Version>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
